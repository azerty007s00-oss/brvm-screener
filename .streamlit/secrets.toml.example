# Renommer ce fichier en secrets.toml et remplir les valeurs.
# NE PAS committer secrets.toml dans git (.gitignore l'exclut).

# Email admin qui reçoit les demandes d'accès
ADMIN_EMAIL = "votre@email.com"

# Compte Gmail expéditeur (activer 2FA + App Password)
GMAIL_USER = "votre@gmail.com"
GMAIL_APP_PASSWORD = "xxxx xxxx xxxx xxxx"

# Token GitHub avec scope 'contents:write' sur le repo de stockage
GITHUB_TOKEN = "ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
GITHUB_REPO = "username/repo-name"

# Clé secrète pour les tokens d'approbation (32 chars min, aléatoire)
# Générer avec : python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY = "remplacer-par-une-chaine-aleatoire-longue"

# URL publique de l'application Streamlit
APP_URL = "https://votre-app.streamlit.app"
