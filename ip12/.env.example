# Base Postgres Neon — onglet Connect de la console, chaine "pooled".
DATABASE_URL="postgresql://utilisateur:motdepasse@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Cle de signature des sessions — 32 caracteres aleatoires minimum.
SESSION_SECRET="remplacez-par-une-chaine-aleatoire-de-32-caracteres-minimum"

# Amorcage du premier compte president (route /api/bootstrap, inerte ensuite).
SETUP_TOKEN="un-second-secret-aleatoire"
BOOTSTRAP_EMAIL="president@exemple.com"
BOOTSTRAP_NOM="Nom du president"

# Relance du 10 — facultatif : sans transport configure, les alertes restent
# visibles sur le site, seul le courrier ne part pas.
#
# Renseigner SMTP_HOST suffit a choisir le SMTP ; a defaut, RESEND_API_KEY.
# Le port dit le mode : 465 ouvre la session en TLS, 587 la chiffre par STARTTLS.
#
#   Gmail : smtp.gmail.com / 465 / l'adresse du club / un MOT DE PASSE
#           D'APPLICATION (le mot de passe du compte est refuse ; il se cree
#           depuis la validation en deux etapes du compte Google).
#   Brevo : smtp-relay.brevo.com / 587 / l'identifiant SMTP / la cle SMTP.
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""

RESEND_API_KEY=""
EMAIL_EXPEDITEUR=""
CRON_SECRET=""

# URL publique, utilisee dans les e-mails de relance.
NEXT_PUBLIC_SITE_URL="https://ip12.vercel.app"
