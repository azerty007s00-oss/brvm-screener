# Base Postgres Neon — onglet Connect de la console, chaine "pooled".
DATABASE_URL="postgresql://utilisateur:motdepasse@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Cle de signature des sessions — 32 caracteres aleatoires minimum.
SESSION_SECRET="remplacez-par-une-chaine-aleatoire-de-32-caracteres-minimum"

# Amorcage du premier compte president (route /api/bootstrap, inerte ensuite).
SETUP_TOKEN="un-second-secret-aleatoire"
BOOTSTRAP_EMAIL="president@exemple.com"
BOOTSTRAP_NOM="Nom du president"

# Relance du 10 — facultatif : sans cle, les alertes restent visibles sur le site.
RESEND_API_KEY=""
EMAIL_EXPEDITEUR="onboarding@resend.dev"
CRON_SECRET=""

# URL publique, utilisee dans les e-mails de relance.
NEXT_PUBLIC_SITE_URL="https://ip12.vercel.app"
